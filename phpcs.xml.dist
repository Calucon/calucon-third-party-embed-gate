<?xml version="1.0"?>
<ruleset name="Calucon Third-Party Embed Gate">
	<description>WordPress coding standards for the Calucon Third-Party Embed Gate plugin.</description>

	<file>calucon-third-party-embed-gate.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>

	<arg name="extensions" value="php"/>
	<arg name="tab-width" value="4"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 autoloading (ConsentGate\ => src/) fixes the file names;
		     WPCS's class-*.php convention cannot coexist with it. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.9"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="calucon-third-party-embed-gate"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ConsentGate"/>
				<element value="consent_gate"/>
				<element value="CONSENT_GATE"/>
			</property>
		</properties>
	</rule>

	<!-- Detection/, Providers/ and Rendering/ are deliberately WordPress-free
	     (CLAUDE.md): WordPress reaches them only as injected callables, so the
	     WP alternative-function sniffs do not apply there. Everything else
	     (Plugin, Integration, Admin, Support, templates) stays under the full
	     ruleset. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>src/Detection/*</exclude-pattern>
		<exclude-pattern>src/Providers/*</exclude-pattern>
		<exclude-pattern>src/Rendering/*</exclude-pattern>
	</rule>
</ruleset>
